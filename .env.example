# Any standard Postgres instance works -- Vercel Postgres, Neon, Supabase,
# Railway, or a local one. Copy this to .env.local for local dev.
DATABASE_URL=postgresql://user:password@host:5432/racelog

# Optional. If set, POST /api/import/raw (used by vrc-bridge/, the local
# VRC Pro memory-reading tool) requires this exact value in an
# X-Import-Token header. Leave unset to allow unauthenticated uploads to
# that endpoint -- fine for personal use, worth setting once this is
# shared beyond just you.
IMPORT_TOKEN=
